# Cong ma server lang nghe (cloudflared se tro vao cong nay)
PORT=8787

# Chi lang nghe tren localhost cho an toan - cloudflared chay cung may.
# Doi thanh 0.0.0.0 neu muon truy cap truc tiep tu LAN (vi du de test voi dien thoai).
HOST=127.0.0.1

# So ngay giu lai thong bao cu (0 = giu mai mai)
RETENTION_DAYS=30

# Gioi han tong so ban ghi trong DB
MAX_ROWS=200000

# Dat 1 khi chay sau Cloudflare Tunnel / reverse proxy
TRUST_PROXY=1

# Dat 1 khi truy cap qua HTTPS (cookie se co co Secure).
# Khi test bang http://localhost thi de 0.
SECURE_COOKIE=1

# Duong dan file SQLite
DB_PATH=./data/notify.db
